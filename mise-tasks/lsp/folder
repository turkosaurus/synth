#!/usr/bin/env bash
#MISE description="write a scratch custom folder at target/lsp from this build"
#MISE hide=true

# The user's own config and custom folder are left alone: synth reads
# both from XDG folders under target/lsp.

set -euo pipefail

scratch="$PWD/target/lsp"
mkdir -p "$scratch"
if ! XDG_CONFIG_HOME="$scratch/config" XDG_DATA_HOME="$scratch/data" \
  cargo run -q -- custom --sync </dev/null; then
  echo "::error title=lsp:folder::synth custom failed"
  exit 1
fi
