#!/usr/bin/env bash
#MISE description="release.yml: the Linux build finds release TAG by its channel and verifies it with update --dry-run"
set -euo pipefail

tag=${TAG:?TAG is the release just published}
tar -xzf synth-x86_64-unknown-linux-gnu.tar.gz
case $tag in
*+*) channel=(--dev "${tag##*+}") ;;
*-*) channel=(--beta) ;;
*) channel=(--stable) ;;
esac
out=$(./synth update --dry-run "${channel[@]}")
echo "$out"
if [[ $out != "synth ${tag#v} verified;"* ]]; then
  echo "::error title=ci:release-verify::update --dry-run ${channel[*]} did not find $tag"
  exit 1
fi
