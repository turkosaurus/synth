#!/usr/bin/env bash
#MISE description="release.yml: pack the release build for <target> with its licenses into synth-<target>.tar.gz"

# GPL-3.0 and the dependencies' licenses travel with the binary.
set -euo pipefail

target=${1:?usage: mise run ci:package <target>}
dir=target/$target/release
bin=synth
if [ "${OS:-}" = Windows_NT ]; then
  bin=synth.exe
fi
mkdir pkg
cp "$dir/$bin" LICENSE THIRD-PARTY-NOTICES.txt pkg/
tar -czf "synth-$target.tar.gz" -C pkg .
