#!/usr/bin/env bash
#MISE description="bench.yml: commit FILE and push it to main, retrying when main moves"

# Main may have moved during the run; the result is a new file, so rebasing
# onto it never conflicts.
set -euo pipefail

file=${FILE:?FILE is the result to commit}
git config user.name "github-actions[bot]"
git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
git add "$file"
git commit -q -m "bench: results for ${GITHUB_SHA:?}"
for attempt in 1 2 3; do
  if git pull -q --rebase origin main && git push -q origin HEAD:main; then
    exit 0
  fi
  echo "push attempt $attempt failed; retrying" >&2
  sleep $((attempt * 5))
done
echo "::error title=bench::could not push the result to main"
exit 1
