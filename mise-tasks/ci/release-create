#!/usr/bin/env bash
#MISE description="release.yml: create release TAG from every asset in dist/"

# one call with every asset, so a release is never seen half uploaded
set -euo pipefail

gh release create "${TAG:?}" dist/* \
  --target "${GITHUB_SHA:?}" \
  --generate-notes \
  --prerelease="${PRERELEASE:?}" \
  --repo "${GITHUB_REPOSITORY:?}"
