#!/usr/bin/env bash
#MISE description="release.yml: tag, build, and prerelease for VERSION, a dev build unless RELEASE=true"

# Semver build metadata names the commit without ordering it, so a dev
# build shows what it was built from and never outranks a release.
set -euo pipefail

version=${VERSION:?VERSION is the version Cargo.toml holds}
out=${GITHUB_OUTPUT:-/dev/null}
if [ "${RELEASE:-}" = true ]; then
  tag="v$version"
else
  sha=${GITHUB_SHA:-$(git rev-parse HEAD)}
  tag="v$version+${sha::7}"
fi
case $tag in
*-* | *+*) prerelease=true ;;
*) prerelease=false ;;
esac
echo "tag=$tag" | tee -a "$out"
echo "build=${tag#v}" | tee -a "$out"
echo "prerelease=$prerelease" | tee -a "$out"
