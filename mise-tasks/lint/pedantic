#!/usr/bin/env bash
#MISE description="clippy pedantic, for review; reports but never fails"

# Inside Actions, pedantic warnings become notices rather than warnings,
# since they are for review and never fail the run.
set -euo pipefail

if [ "${GITHUB_ACTIONS:-}" != true ]; then
    exec cargo clippy --all-targets -- -W clippy::pedantic
fi
cargo clippy --all-targets --message-format=json -- -W clippy::pedantic |
    jq -jRn --arg warning notice -f .github/annotations/cargo.jq
