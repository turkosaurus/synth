#!/usr/bin/env bash
#MISE description="clippy on every target; any warning fails"

# Inside Actions, diagnostics also become annotations (.github/annotations).
set -euo pipefail

if [ "${GITHUB_ACTIONS:-}" != true ]; then
    exec cargo clippy --all-targets -- -D warnings
fi
cargo clippy --all-targets --message-format=json -- -D warnings |
    jq -jRn --arg warning warning -f .github/annotations/cargo.jq
