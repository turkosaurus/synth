#!/usr/bin/env bash
#MISE description="lua-language-server and Neovim in a patches folder: each tests/lua/lsp/ case flagged, all else clean"
#MISE depends=["lsp:folder"]

# lint:lua checks the modules themselves. This checks what a user gets: a
# folder written by `synth patches`, where .luarc.json lets the language
# server resolve `require("synth")` and read the annotations.

set -euo pipefail

scratch="$PWD/target/lsp"
patches="$scratch/data/synth/patches"
cases="$PWD/tests/lua/lsp"

rm -rf "$patches/expect"
mkdir "$patches/expect"
cp "$cases"/*.lua "$patches/expect/"

report="$scratch/check.json"
rm -f "$report"
# exits nonzero when anything is found, which the cases always are
lua-language-server --check "$patches" --checklevel=Warning \
  --check_format=json --check_out_path="$report" \
  --logpath="$scratch/log" >/dev/null || true
if [[ ! -f $report ]]; then
  echo "::error title=lint:lsp::lua-language-server wrote no report"
  exit 1
fi

# file name, then each diagnostic code found in it
found=$(jq -r 'to_entries[]
  | "\(.key | sub("^file://"; "")) \([.value[].code] | unique | join(","))"' \
  "$report")

failed=0
for path in "$cases"/*.lua; do
  name=$(basename "$path")
  expected=$(sed -n '1s/^-- expect: //p' "$path")
  if [[ -z $expected ]]; then
    echo "::error file=tests/lua/lsp/$name,title=lint:lsp::the first line must be \`-- expect: <code>\`"
    failed=1
    continue
  fi
  codes=$(awk -v file="$patches/expect/$name" '$1 == file { print $2 }' <<<"$found")
  if [[ $codes != "$expected" ]]; then
    echo "::error file=tests/lua/lsp/$name,title=lint:lsp::expected $expected, got ${codes:-nothing}"
    failed=1
  fi
done

# every other file, the starters and built-in copies included, is clean
while read -r file codes; do
  [[ -z $file || $file == "$patches/expect/"* ]] && continue
  echo "::error title=lint:lsp::${file#"$patches/"}: $codes"
  failed=1
done <<<"$found"

rm -rf "$patches/expect"

if ! nvim --headless --clean -l tests/nvim/lsp.lua "$patches"; then
  echo "::error file=tests/nvim/lsp.lua,title=lint:lsp::Neovim did not see the annotations"
  failed=1
fi
exit "$failed"
