#!/usr/bin/env bash
#MISE description="lua/config.lua changed since VERSION_BASE (default origin/main) names Cargo.toml's version"
#
# A user's config.lua older than the built-in one is out of date, so a
# change to the built-in must carry the release it ships in.
set -euo pipefail

base=${VERSION_BASE:-origin/main}
file=lua/config.lua

fail() {
  echo "::error file=$file,title=lint:config::$*"
  exit 1
}

if ! fork=$(git merge-base "$base" HEAD); then
  fail "cannot find where HEAD left $base; fetch it, or set VERSION_BASE"
fi
if git diff --quiet "$fork" -- "$file"; then
  exit 0
fi

if ! cargo=$(yq -p toml -oy -r '.package.version' Cargo.toml); then
  fail "cannot read the version from Cargo.toml"
fi
config=$(grep -oE '^\s*version = "[^"]*"' "$file" | grep -oE '"[^"]*"' | tr -d '"' || true)
if [ "$config" != "$cargo" ]; then
  fail "$file changed since $base, so its version must be Cargo.toml's $cargo, not '${config:-none}'"
fi
