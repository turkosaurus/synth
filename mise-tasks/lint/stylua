#!/usr/bin/env bash
#MISE description="stylua formatting check on lua/; any difference fails"

# Inside Actions, each unformatted range becomes an error annotation.
set -euo pipefail

if [ "${GITHUB_ACTIONS:-}" != true ]; then
    exec stylua --check lua
fi
stylua --check --output-format=json lua | jq -r -f .github/annotations/stylua.jq
