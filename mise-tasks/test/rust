#!/usr/bin/env bash
#MISE description="cargo tests"

# Inside Actions, compiler diagnostics and test panics become annotations.
set -euo pipefail

if [ "${GITHUB_ACTIONS:-}" != true ]; then
    exec cargo test --verbose -- --show-output
fi
cargo test --verbose --message-format=json -- --show-output |
    jq -jRn --arg warning warning -f .github/annotations/cargo.jq
