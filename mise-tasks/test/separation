#!/usr/bin/env bash
#MISE description="lua stays in script.rs and script/, cpal stays in audio/device.rs, crossterm stays in view/ and terminal.rs, spec/ depends on none of them, view widgets use only core, alloc, ratatui, and crate::approx"
set -euo pipefail

failed=0

# allowed paths are extended regexes, anchored at the start
for rule in 'mlua:src/script(\.rs|/)' 'cpal:src/audio/device\.rs' 'crossterm:src/(view/|terminal\.rs)'; do
    name=${rule%%:*}
    allowed=${rule#*:}
    if offenders=$(grep -rln "use $name\|$name::" src/ | grep -vE "^($allowed)"); then
        echo "::error title=test:separation::$name must stay in $allowed"
        echo "$name must stay in $allowed, found in:" >&2
        echo "$offenders" >&2
        failed=1
    fi
done

# spec is plain data between script and audio, so it names neither
if offenders=$(grep -rlE "(crate|mlua|cpal)::" src/spec.rs src/spec/); then
    echo "spec must not depend on the rest of the crate, found in:" >&2
    echo "$offenders" >&2
    failed=1
fi

# view widgets draw on an embedded display too: core, alloc, ratatui, and
# the core-only crate::approx
widgets=(src/view/scope.rs src/view/spectrum.rs)
for widget in "${widgets[@]}"; do
    body=$(sed '/^#\[cfg(test)\]/,$d' "$widget")
    if grep -vE "^use crate::approx;$" <<<"$body" | grep -qE "std::|crate::|crossterm"; then
        echo "::error title=test:separation::$widget must use only core, alloc, ratatui, and crate::approx"
        echo "$widget must use only core, alloc, ratatui, and crate::approx" >&2
        failed=1
    fi
done

exit $failed
