#!/usr/bin/env bash
#MISE description="check Cargo.toml's version against the previous one and the tags: VERSION_BASE=<ref> mise run version"
#
# One check, run twice: by test.yml on a PR, so a bad bump fails before merge,
# and by release.yml after merge, to decide whether to release. Both read the
# version from HEAD and compare with VERSION_BASE, the git ref holding the
# previous version. An empty VERSION_BASE means a manual release of the
# version as it stands, with nothing to compare against.
#
# A version is MAJOR.MINOR.PATCH, or MAJOR.MINOR.PATCH-beta.N for a beta.
#
# Prints version=X.Y.Z and release=true|false, and appends both to
# $GITHUB_OUTPUT inside Actions. A release is a notice and a failure an error;
# an unchanged version is only logged.
set -euo pipefail

base=${VERSION_BASE:-}
num='(0|[1-9][0-9]*)'
semver="^$num\.$num\.$num(-beta\.$num)?$"

note() { echo "::notice::$*"; }
fail() {
    echo "::error::$*"
    exit 1
}
emit() {
    echo "$1"
    if [ -n "${GITHUB_OUTPUT:-}" ]; then
        echo "$1" >>"$GITHUB_OUTPUT"
    fi
}

# Prints the highest of the versions on stdin, in semver order.
# sort -V puts 0.4.0-beta.1 after 0.4.0, so each version is keyed as
# MAJOR MINOR PATCH STABLE BETA, where a release sorts after its betas.
highest() {
    local v core rank
    while read -r v; do
        core=${v%%-*}
        if [[ $v == *-beta.* ]]; then rank="0 ${v##*.}"; else rank="1 0"; fi
        echo "${core//./ } $rank $v"
    done | sort -n -k1,1 -k2,2 -k3,3 -k4,4 -k5,5 | tail -1 | cut -d' ' -f6
}

# from a revision, not the working tree, so the previous version is readable
# without checking it out
version_of() {
    git show "$1:Cargo.toml" | yq -p toml -r '.package.version'
}

if ! new=$(version_of HEAD); then
    fail "cannot read the version from Cargo.toml"
fi
if [[ ! $new =~ $semver ]]; then
    fail "Cargo.toml version '$new' is not MAJOR.MINOR.PATCH or MAJOR.MINOR.PATCH-beta.N"
fi
emit "version=$new"

old=""
if [ -n "$base" ]; then
    if ! old=$(version_of "$base"); then
        fail "cannot read Cargo.toml at $base"
    fi

    # Cargo.toml changed for another reason, a dependency most likely.
    # Not a release, not a failure.
    if [ "$new" = "$old" ]; then
        emit "release=false"
        # a log line, not a notice: notices are for a run that does something
        echo "version stays $new; nothing to release"
        exit 0
    fi

    # exactly one bump from the previous version, which catches typos such
    # as 0.1.0 to 0.10.0 before they become a permanent tag
    if [[ ! $old =~ $semver ]]; then
        fail "previous version '$old' at $base is not a version"
    fi
    if [[ $old == *-beta.* ]]; then
        # a beta moves to its next beta or to its own release
        core=${old%%-*}
        beta=${old##*.}
        expected=("$core-beta.$((beta + 1))" "$core")
    else
        # a release moves to the next release, or starts that release's betas
        IFS=. read -r major minor patch <<<"$old"
        expected=()
        for next in "$major.$minor.$((patch + 1))" "$major.$((minor + 1)).0" "$((major + 1)).0.0"; do
            expected+=("$next" "$next-beta.1")
        done
    fi
    found=false
    for next in "${expected[@]}"; do
        if [ "$new" = "$next" ]; then found=true; fi
    done
    if ! $found; then
        fail "$old to $new is not one bump; expected one of ${expected[*]}"
    fi
fi

if git rev-parse -q --verify "refs/tags/v$new" >/dev/null; then
    fail "tag v$new already exists"
fi

# tags that are not versions are ignored rather than compared
latest=$(git tag --list 'v*' | sed 's/^v//' | { grep -E "$semver" || true; } | highest)
if [ -n "$latest" ]; then
    if [ "$(printf '%s\n%s\n' "$latest" "$new" | highest)" != "$new" ]; then
        fail "$new does not move forward from the latest tag v$latest"
    fi
fi

emit "release=true"
note "v$new is ready to release; previous tag ${latest:+v}${latest:-none}"
