# https://editorconfig.org: most editors read this on their own or with a
# plugin. stylua and rustfmt still decide formatting; this only stops
# trailing spaces before they reach lint:stylua.
root = true

[*]
trim_trailing_whitespace = true
insert_final_newline = true

# two trailing spaces are a line break in Markdown
[*.md]
trim_trailing_whitespace = false
